# ==============================================================================
# PayGuard AI - Environment Configuration Example
# Copy this file to .env and configure keys as needed.
# Note: Zero-Key mode works 100% out of the box with built-in deterministic rules!
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini AI Integration (Optional)
# If omitted or left as placeholder, PayGuard AI automatically uses its zero-key
# deterministic explainability engine.
# Obtain a key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
# Preferred Gemini model: gemini-2.5-flash, gemini-2.0-flash, or gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# PayPal Developer Sandbox REST Credentials (Optional)
# If omitted, PayGuard AI runs in realistic synthetic demo sandbox mode.
# Obtain Sandbox credentials from:
# https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# ------------------------------------------------------------------------------
# Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=3000
AUTO_OPEN="true"
NODE_ENV="development"
